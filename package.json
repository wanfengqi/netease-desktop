{
  "name": "netease-desktop",
  "version": "2.0.0",
  "description": "网易云音乐简易桌面版 - 支持更换皮肤",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:dir": "npm run build:renderer && electron-builder --dir",
    "build": "npm run build:renderer && electron-builder --win nsis",
    "dev": "node scripts/dev.cjs",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "migu-api-enhanced": "^2.27.5",
    "NeteaseCloudMusicApi": "^4.32.0",
    "pinia": "^4.1.0"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "build": {
    "appId": "com.dsh.netease.desktop",
    "productName": "网易云音乐桌面版",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!electron/**/__tests__/**",
      "!legacy/**",
      "!docs/**",
      "!shots/**",
      "!tools/**",
      "!**/*.map",
      "!**/{test,tests,__tests__,example,examples,docs,doc,man}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "shortcutName": "网易云音乐桌面版"
    },
    "asarUnpack": [
      "node_modules/**/*"
    ]
  }
}
