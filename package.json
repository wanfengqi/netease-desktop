{
  "name": "netease-desktop",
  "version": "1.0.0",
  "description": "网易云音乐简易桌面版 - 支持更换皮肤",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:dir": "electron-builder --dir",
    "build": "electron-builder --win nsis",
    "dev": "node scripts/dev.cjs",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "migu-api-enhanced": "^2.27.5",
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "build": {
    "appId": "com.dsh.netease.desktop",
    "productName": "网易云音乐桌面版",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/@electron/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/dmg-builder/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/electron-winstaller/**",
      "!**/*.map",
      "!**/{test,tests,__tests__,example,examples,docs,doc,man}/**",
      "!**/{.eslintrc,.eslintrc.js,.eslintrc.json,.npmignore,CHANGELOG.md,changelog.md,.github}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "网易云音乐桌面版"
    },
    "asarUnpack": [
      "node_modules/**/*"
    ]
  }
}
